<?xml version="1.0" encoding="utf-8"?><!--
   API 30 以下のバックアップ対象を定める。API 31 以上は data_extraction_rules.xml が使われる。
   https://developer.android.com/guide/topics/data/autobackup

   FANBOX の認証 Cookie を持つファイルを除外する。secure store の内容は Keystore の鍵で
   暗号化されており、鍵は端末外に出ないため復元先では復号できない。旧 Room DB は平文である。
   いずれも復元しても使えないため、バックアップに含めない。
-->
<full-backup-content>
    <exclude domain="file" path="datastore/eu_anifantakis_ksafe_datastore.preferences_pb" />
    <exclude domain="database" path="fankt.db" />
    <exclude domain="database" path="fankt.db-wal" />
    <exclude domain="database" path="fankt.db-shm" />
</full-backup-content>
